# Kopiere diese Datei nach .env und trage echte Werte ein.
# .env ist per .gitignore ausgeschlossen und gehoert NIE ins Repository.
#
# Ohne Schluessel laeuft weiterhin alles ausser der echten Suche:
# der Provider "fixture" arbeitet offline mit gespeicherten Antworten,
# und "fbgroups search --dry-run" zeigt Plan und Verbrauch ohne Abruf.

# --- Serper.dev ---
# 2.500 Gratis-Credits, 6 Monate gueltig. 1 Credit = 1 Anfrage bis 10 Treffer.
# Schluessel anlegen: https://serper.dev - ohne Kreditkarte, ohne Auto-Top-Up.
# Ist das Gratis-Kontingent aufgebraucht, endet ein Lauf geordnet; es wird
# nichts nachgekauft und nicht auf einen anderen Dienst ausgewichen.
SERPER_API_KEY=

# --- Brave Search API ---
# 5 $ Guthaben monatlich, erneuert sich (~1.000 Anfragen/Monat).
# ACHTUNG: verlangt bei der Anmeldung eine Kreditkarte und hat seit Februar
# 2026 keine Ausgabenobergrenze. In config/providers.yaml deshalb deaktiviert.
BRAVE_API_KEY=

# --- Marketing / Tracking ---
# Basis-URL der Anwendung, die {APP_BASE_URL}/r/{tracking_code} entgegennimmt.
# Hat Vorrang vor marketing.app_base_url in config/settings.yaml. Die
# Tracking-Codes bleiben beim Wechsel unveraendert; nur die Links werden mit
# 'fbgroups campaign refresh-urls' neu geschrieben.
# APP_BASE_URL=http://localhost:3000

# FBGROUPS_LOG_LEVEL=INFO
