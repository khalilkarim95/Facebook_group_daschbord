.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Secrets: nur die Vorlage gehoert ins Repository. Auch Sicherungskopien
# wie .env.bak-JJJJ-MM-TT tragen echte Schluessel.
.env
.env.*
!.env.example
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Laufzeitdaten: Rohdaten und Exporte gehoeren nicht ins Repository
data/cache/
data/runs/
data/exports/
data/backups/
data/*.sqlite
data/*.sqlite-journal
data/*.sqlite-wal
data/*.sqlite-shm
# Sicherungskopien des Bestands (bak-vor-reset, bak-vor-zuordnung ...)
data/*.sqlite.bak*
data/*.bak-*

# Seeds: Beispieldatei bleibt versioniert, echte Seeds nicht
data/seeds/*
!data/seeds/example_seeds.csv
