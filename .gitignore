.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Secrets: nur die Vorlage gehoert ins Repository. Auch Sicherungskopien
# wie .env.bak-JJJJ-MM-TT tragen echte Schluessel.
.env
.env.*
!.env.example
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Laufzeitdaten: Rohdaten und Exporte gehoeren nicht ins Repository
data/cache/
data/runs/
data/exports/
data/backups/
data/backup/
data/browser_state/
# Seit dem Umzug (25.09.2026): Tagesprotokolle, die heruntergeladene
# Server-Kopie und der Vermerk, dass umgezogen ist - alles Laufzeit.
data/logs/
data/umzug/
data/umgezogen.txt
# Die Sperre eines laufenden `campaign automatik` - Laufzeit, kein Code.
data/*.lock
data/*.sqlite
data/*.sqlite-journal
data/*.sqlite-wal
data/*.sqlite-shm
# Sicherungskopien des Bestands (bak-vor-reset, bak-vor-zuordnung ...)
data/*.sqlite.bak*
data/*.sqlite.alt
data/*.bak-*
*.bak
test_results.txt

# Die von Hand gesammelten Mitgliederlisten. Sie sind Bestandsdaten und
# gehoeren wie alles unter data/ nicht ins Repository - `ausrollen.sh
# --mitglieder` traegt sie eigens hinueber.
data/from_lokal/
